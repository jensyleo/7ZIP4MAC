+// Reads one line from standard input and returns it as a password, without
+// the line ending. Lets a caller supply a password without putting it on the
+// command line, where other users of the machine could read it. Returns nil
+// if nothing could be read.
+NSString *ReadPasswordFromStdin(void)
+{
+	char *line=NULL;
+	size_t capacity=0;
+	ssize_t length=getline(&line,&capacity,stdin);
+	if(length<0) { free(line); return nil; }
+	while(length>0&&(line[length-1]=='\n'||line[length-1]=='\r')) line[--length]=0;
+	NSString *password=[NSString stringWithUTF8String:line];
+	memset(line,0,capacity);
+	free(line);
+	return password;
+}
